# 복사해서 저장소 루트에 `.env`로 저장한다. 두 프로젝트(ai-trading-bot, gmail-newsletter-analyzer)가
# 같은 파일을 읽는다(프로젝트 폴더의 .env가 있으면 그쪽이 우선).
# 모의투자(PAPER) 키만 있으면 매매 파이프라인 전체가 돈다. REAL 키는 비워 두어도 되고,
# 넣더라도 config/limits.json 의 real_trading_enabled=false 래치가 전송을 막는다.

# Gmail — IMAP 앱 비밀번호 (2단계 인증 계정에서 발급)
GMAIL_ADDRESS=you@example.com
GMAIL_APP_PASSWORD=

# DART 전자공시 Open API (https://opendart.fss.or.kr)
DART_API_KEY=

# 한국투자증권 KIS Developers — 모의투자
KIS_PAPER_APP_KEY=
KIS_PAPER_APP_SECRET=
KIS_PAPER_ACCOUNT=00000000-01

# 한국투자증권 — 실계좌 (사용하지 않음; limits.json 래치로 차단)
KIS_REAL_APP_KEY=
KIS_REAL_APP_SECRET=
KIS_REAL_ACCOUNT=
